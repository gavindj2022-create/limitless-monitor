{
  "name": "limitless-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --remote --test-scheduled",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply limitless_monitor --local",
    "d1:migrate:remote": "wrangler d1 migrations apply limitless_monitor --remote"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.22.0"
  }
}
